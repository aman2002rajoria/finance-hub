# The public site on Vercel shows made-up test data only.
# NEXT_PUBLIC_TEST_ONLY=1 locks it to test data and removes the route to your own data.
NEXT_PUBLIC_TEST_ONLY=1
# The test-data backend (the "backend" folder deployed as its own Vercel project).
# Change this if that project ends up at a different address.
NEXT_PUBLIC_DEMO_API_URL=https://finance-hub-api.vercel.app
